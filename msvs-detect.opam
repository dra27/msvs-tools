opam-version: "2.0"
maintainer: "david.allsopp@metastack.com"
authors: "David Allsopp"
license: "BSD-3-clause"
homepage: "https://github.com/metastack/msvs-tools#readme"
dev-repo: "git+https://github.com/metastack/msvs-tools.git"
bug-reports: "https://github.com/metastack/msvs-tools/issues"
build: [
  [ "bash" "./msvs-opam" arch name ]
]
setenv: [
  [PATH += "%{_:msvs-bin}%"]
  [INCLUDE += "%{_:msvs-inc}%"]
  [LIB += "%{_:msvs-lib}%"]
]
x-env-path-rewrite: [
  [ PATH false ]
]
available: os = "win32" | os = "cygwin"
flags: compiler
synopsis: "Microsoft Visual Studio Environment Settings"
description: "Uses msvs-tools to detect Visual Studio and set-up the environment."
